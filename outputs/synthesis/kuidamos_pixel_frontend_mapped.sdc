# Created by write_sdc on Mon Nov 9 00:30:46 2026

###################################################################
set sdc_version 2.2

set_units -time ns -resistance MOhm -capacitance fF -voltage V -current uA
set_load -pin_load 0.05 [get_ports {pixel_out[7]}]
set_load -pin_load 0.05 [get_ports {pixel_out[6]}]
set_load -pin_load 0.05 [get_ports {pixel_out[5]}]
set_load -pin_load 0.05 [get_ports {pixel_out[4]}]
set_load -pin_load 0.05 [get_ports {pixel_out[3]}]
set_load -pin_load 0.05 [get_ports {pixel_out[2]}]
set_load -pin_load 0.05 [get_ports {pixel_out[1]}]
set_load -pin_load 0.05 [get_ports {pixel_out[0]}]
set_load -pin_load 0.05 [get_ports pixel_out_valid]
set_load -pin_load 0.05 [get_ports out_sof]
set_load -pin_load 0.05 [get_ports out_sol]
set_load -pin_load 0.05 [get_ports out_eol]
set_load -pin_load 0.05 [get_ports out_eof]
set_load -pin_load 0.05 [get_ports cfg_error]
create_clock [get_ports clk]  -period 10  -waveform {0 5}
set_clock_uncertainty -setup 0.2  [get_clocks clk]
set_clock_uncertainty -hold 0.05  [get_clocks clk]
set_clock_transition -max -rise 0.1 [get_clocks clk]
set_clock_transition -max -fall 0.1 [get_clocks clk]
set_clock_transition -min -rise 0.1 [get_clocks clk]
set_clock_transition -min -fall 0.1 [get_clocks clk]
set_input_delay -clock clk  -max 2  [get_ports reset_n]
set_input_delay -clock clk  -min 0.2  [get_ports reset_n]
